# 情感陪伴助手（可选；未配置时功能会明确提示，其他模块不受影响）
# 复制为 .env 后按需填写；.env 已被 gitignore，不会提交
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT_MS=45000
# 每个用户每天可获得的正常模型回复次数；即时危机安全回复不占用此次数（1–10000）
COMPANION_DAILY_MODEL_REPLY_LIMIT=100

# —— 邮件提醒（QQ 邮箱 SMTP） ——
# 1. QQ 邮箱 → 设置 → 账户 → 开启「POP3/SMTP 服务」
# 2. 按提示生成授权码（16 位），填入 SMTP_PASS（不是 QQ 登录密码）
# 3. 重启服务端后，在「设置 → 邮件提醒」点「发送测试邮件」验证
# 详见 docs/api/notification.md
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=   # 可选，默认与 SMTP_USER 相同

# —— 服务端口 / 数据目录（可选） ——
# PORT=4000
# RESONANCE_DATA_DIR=server/data
